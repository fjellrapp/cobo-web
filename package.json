{
	"name": "cobo-web",
	"version": "0.0.2",
	"packageManager": "pnpm@10.18.3",
	"engines": {
		"node": ">=22.17.0"
	},
	"imports": {
		"#lib/*.svelte": "./src/lib/*.svelte",
		"#lib/*.ts": "./src/lib/*.ts",
		"#lib/*": "./src/lib/*.ts"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check 'src/**/*.svelte' 'src/routes/**/*.ts' 'src/hooks.server.ts' 'src/stories/**/*.{ts,svelte}' '.storybook/**/*.{ts,js}' '*.config.js' 'package.json' 'tsconfig.json' 'README.md' && eslint src/lib/components src/lib/modules src/routes src/hooks.server.ts src/stories .storybook eslint.config.js",
		"format": "prettier --write .",
		"story:dev": "storybook dev -p 6006",
		"story:build": "storybook build"
	},
	"devDependencies": {
		"@fontsource/fira-mono": "^4.5.0",
		"@storybook/addon-docs": "^10.6.1",
		"@storybook/svelte": "^10.6.1",
		"@storybook/sveltekit": "^10.6.1",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@typescript-eslint/eslint-plugin": "^8.71.0",
		"@typescript-eslint/parser": "^8.71.0",
		"autoprefixer": "^10.4.13",
		"esbuild": "^0.28.2",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-storybook": "^10.6.1",
		"eslint-plugin-svelte": "^3.14.0",
		"postcss": "^8.4.19",
		"postcss-load-config": "^4.0.1",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"sass": "^1.56.1",
		"storybook": "^10.6.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^3.2.4",
		"tslib": "^2.3.1",
		"tsx": "^4.19.3",
		"typescript": "^6.0.2",
		"vite": "^8.0.12"
	},
	"type": "module",
	"dependencies": {
		"@prisma/client": "^6.6.0",
		"axios": "^1.2.0",
		"classnames": "^2.3.2",
		"cookie": "^2.0.1",
		"felte": "^1.2.6",
		"prisma": "^6.6.0",
		"yup": "^1.7.1"
	}
}
